{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "exactOptionalPropertyTypes": false,
      "types": ["node"]
    },
    "include": [
      "playwright.config.ts",
      "tsconfig.json",
      "e2e/**/*.ts",
      "api/**/*.ts"
    ]
  }